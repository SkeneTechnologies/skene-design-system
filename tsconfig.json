{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vitest/globals"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "scripts",
    "__tests__",
    "stories",
    ".storybook"
  ]
}
